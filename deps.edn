{:paths ["src" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.ring-clojure/ring-core-protocols {:mvn/version "1.15.5"}
        org.ring-clojure/ring-websocket-protocols {:mvn/version "1.15.5"}
        org.eclipse.jetty/jetty-server {:mvn/version "12.1.13"}
        org.eclipse.jetty/jetty-util {:mvn/version "12.1.13"}
        org.eclipse.jetty.websocket/jetty-websocket-jetty-api {:mvn/version "12.1.13"}
        org.eclipse.jetty.websocket/jetty-websocket-jetty-server {:mvn/version "12.1.13"}}
 :deps/prep-lib {:alias :build :fn compile-handlers :ensure "target/classes/.prepared"}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]}}}
